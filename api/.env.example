PLATFORM_URL=https://your-region.cloud.grassvalley.com
API_KEY=your-api-key
#WORKLOAD_ID=
#MACRO_ID=
#FABRIC_ID=
#NODE_ID=

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Requires the Admin repository's db_schema/gvui_20261023 schema before deployment.
# Generated with: $ openssl rand -base64 48
SESSION_SECRET=
# Expiry-only renewals: 60 seconds by default; 0 restores renewal on every touch.
# Idle expiry can occur up to this interval earlier than eight hours after activity.
# Full session-data saves and ten-second permission checks remain immediate.
SESSION_TOUCH_INTERVAL_MS=60000

# Recorder input routing: operation budget includes native preparation.
AMPP_RECORDER_ROUTE_TIMEOUT_MS=10000
AMPP_RECORDER_OPERATION_TIMEOUT_MS=60000

# DEBUG VARS
WEBRTC_DEBUG=false
AMPP_NOTIFICATIONS_DEBUG=false
# Temporary GVUI browser diagnostics. See test/GVUI-browser-diagnostics.md.
AMPP_PROXY_BROWSER_DIAGNOSTICS=false
# Temporary server request/session/mailbox/WebSocket tracing. See test/AMPP-request-tracing.md.
AMPP_PROXY_TRACE=false


