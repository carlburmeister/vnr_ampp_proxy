# Retest live notifications, OAuth, controls and media before general rollout.
GVUI_PHASE2_ENABLED=false

# Generated with: $ openssl rand -base64 48
SESSION_SECRET=

# DEBUG VARS
WEBRTC_DEBUG=false
AMPP_NOTIFICATIONS_DEBUG=false


